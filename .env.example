# Contact form (Resend) — required for /api/contact to actually send mail
# Sign up: https://resend.com   →   Dashboard → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where contact-form submissions are delivered. Defaults to polanmusic2025@gmail.com.
CONTACT_TO_EMAIL=polanmusic2025@gmail.com

# "From" header for outgoing mail.
# Until dolcenforte.com is verified in Resend, leave the default below.
# After verifying the domain, change to: Dolce & Forte <hello@dolcenforte.com>
CONTACT_FROM_EMAIL=Dolce & Forte <onboarding@resend.dev>

# Optional — every submission is also POSTed here as JSON.
# Plug in a Google Sheet (Apps Script), Discord webhook, Slack incoming webhook,
# Notion endpoint, etc. Leave blank to skip.
# BACKUP_WEBHOOK_URL=
